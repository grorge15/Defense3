+should('AC-BOSS-ATTACK-RECOVERY: animation completion unlocks only its current attack', () => {
+    clearLoaded(['assets/scripts/enemy/EnemyBoss.ts']);
+    const base = actualScriptMocks();
+    const { EnemyBoss } = loadTs('assets/scripts/enemy/EnemyBoss.ts', base.mocks);
+    const boss = new EnemyBoss();
+    boss.node = componentNode('boss-recovery', 0, 0);
+    boss.visualNode = componentNode('boss-recovery-visual', 0, 0, new Map([[base.cc.Animation, {
+        getState: () => ({ duration: 1.3, speed: 2 }),
+    }]]));
+    const player = componentNode('boss-recovery-player', 1, 0, new Map([[base.classes.Player, new base.classes.Player()]]));
+    boss._lockedTarget = player;
+    boss._isDead = false;
+    boss._canMove = true;
+    boss._attackTimer = 0;
+    boss.attackTriggerRange = 56;
+
+    boss.tryAttack();
+    const firstFinish = base.getAttackFinish();
+    assert.strictEqual(typeof firstFinish, 'function', 'attack registers a completion callback');
+    assert.strictEqual(boss._isAttacking, true, 'attack stays locked before its animation finishes');
+    firstFinish();
+    assert.strictEqual(boss._isAttacking, false, 'current animation completion releases the movement lock');
+    assert.ok(boss._attackTimer > 0, 'animation completion does not clear attack cooldown');
+
+    boss._attackTimer = 0;
+    boss.tryAttack();
+    const secondFinish = base.getAttackFinish();
+    firstFinish();
+    assert.strictEqual(boss._isAttacking, true, 'late completion from the prior attack cannot unlock a new attack');
+    assert.ok(boss._scheduled.some((entry) => entry.delay === 0.8), 'missing FINISHED has a short recovery fallback');
+    secondFinish();
+    assert.strictEqual(boss._isAttacking, false, 'current completion still releases the new attack');
+});
+

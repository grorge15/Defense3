+    private _navigationConfigSignature(): string {
+        const parts = [
+            this.navBoundsMin?.uuid ?? '',
+            this.navBoundsMax?.uuid ?? '',
+            ...this.castleArea.map((n) => n?.uuid ?? ''),
+            ...this.walkableGround.map((n) => n?.uuid ?? ''),
+            ...this.entrances.map((e) =>
+                [
+                    e.id,
+                    e.outside?.uuid ?? '',
+                    e.inside?.uuid ?? '',
+                    e.closePlot?.uuid ?? '',
+                    e.width,
+                    e.id === 2 ? true : e.open,
+                ].join(':'),
+            ),
+        ];
+        return parts.join('|');
+    }
